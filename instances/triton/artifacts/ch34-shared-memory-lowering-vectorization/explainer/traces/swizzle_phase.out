LinearLayout row-bases {row: colshift}: {1: 0, 2: 8, 4: 16}

row | floor=r//pP | phase | ldmx col=idx^phase | vec*phase | LL(XOR bases) | linear-match
  0 |           0 |     0 |                  3 |         0 | 0             | True
  1 |           0 |     0 |                  3 |         0 | 0             | True
  2 |           1 |     1 |                  2 |         8 | 8             | True
  3 |           1 |     1 |                  2 |         8 | 8             | True
  4 |           2 |     2 |                  1 |        16 | 16            | True
  5 |           2 |     2 |                  1 |        16 | 16            | True
  6 |           3 |     3 |                  0 |        24 | 24            | True
  7 |           3 |     3 |                  0 |        24 | 24            | True
  8 |           4 |     0 |                  3 |         0 | (period wrap) | (row8==row0)

period (rows) = perPhase*maxPhase = 8
distinct phases = 4 -> up to 4 -way bank spread
row 0: cols [0, 1, 2, 3, 4, 5, 6, 7] -> swizzled [0, 1, 2, 3, 4, 5, 6, 7]  bijection=True
row 2: cols [0, 1, 2, 3, 4, 5, 6, 7] -> swizzled [1, 0, 3, 2, 5, 4, 7, 6]  bijection=True
row 4: cols [0, 1, 2, 3, 4, 5, 6, 7] -> swizzled [2, 3, 0, 1, 6, 7, 4, 5]  bijection=True
row 6: cols [0, 1, 2, 3, 4, 5, 6, 7] -> swizzled [3, 2, 1, 0, 7, 6, 5, 4]  bijection=True
