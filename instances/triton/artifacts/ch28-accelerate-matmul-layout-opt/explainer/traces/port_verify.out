====================================================================
[mma-version-select] getMMAVersionSafe(cap, dot) 逐场景
cap  A/B    K   retShape  nW  prec  | candidates -> per-version -> chosen
 70 f16/f16  64 (128, 128)  4 ieee  | [1] -> [(1, True)] -> chosen=v1
 80 f16/f16  64 (128, 128)  4 ieee  | [2] -> [(2, True)] -> chosen=v2
 90 f16/f16  64 (128, 128)  4 ieee  | [3, 2] -> [(3, True)] -> chosen=v3
 90 f16/f16   8 (128, 128)  4 ieee  | [3, 2] -> [(3, False), (2, True)] -> chosen=v2
 90 f32/f32  64 (128, 128)  4 tf32  | [3, 2] -> [(3, True)] -> chosen=v3
 90 f32/f32  64 (128, 128)  4 ieee  | [3, 2] -> [(3, False), (2, False)] -> chosen=v0
====================================================================
[warps-per-tile v2] shape=(128,128) numWarps=8 单 dot 贪心
  iter1: ret=[1, 1] prod=1 LHS=8 RHS=8 -> M*2
  iter2: ret=[2, 1] prod=2 LHS=4 RHS=8 -> N*2
  iter3: ret=[2, 2] prod=4 LHS=4 RHS=4 -> M*2
  iter4: ret=[4, 2] prod=8 LHS=None RHS=None -> break
  => warpsPerTile = [4, 2] (total 8), per-warp tile = [32,64]
  chained dot shape=(128,64) nW=8 (M>=N) => [8, 1]
====================================================================
[instr-shape] mmaVersionToInstrShape
  v1 elt=f16 shape=(128, 128) nW=4 -> instrShape=[16, 16]  {}
  v2 elt=f16 shape=(128, 128) nW=4 -> instrShape=[16, 8]  {}
  v3 elt=f16 shape=(128, 128) nW=4 -> instrShape=[16, 128, 16]  {'k': 16, 'mWarps': 8, 'nWarps': 1, 'maxN': 128, 'n': 128}
  v3 elt=f16 shape=(32, 128) nW=8 -> instrShape=[16, 32, 16]  {'k': 16, 'mWarps': 2, 'nWarps': 4, 'maxN': 32, 'n': 32}
====================================================================
[warps-per-tile v3]
  v3 f16 shape=(128,128) nW=8 instrShape[1]=128 -> [8, 1]
  v3 chained (flash-attn) nW=8 -> [8, 1]
