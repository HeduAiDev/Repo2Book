=== ch26 first-fit allocation derivation (v3.2.0 Allocation.cpp) ===

[initial (all offset 0)]
  offsets = {'A': 0, 'B': 0, 'C': 0}
  interference = {'A': ['B'], 'B': ['A', 'C'], 'C': ['B']}

[after allocate round 1]
  colors  = {'A': 0, 'B': 1, 'C': 0}
  offsets = {'A': 0, 'B': 1024, 'C': 0}
  interference (rebuilt) = {'A': [], 'B': [], 'C': []}
  sharedMemorySize = max(offset+size) = 1536 bytes

=== summary ===
  A: size=1024B live=(1, 4) offset=0 addr=[0,1024)
  B: size=512B live=(3, 6) offset=1024 addr=[1024,1536)
  C: size=1024B live=(5, 8) offset=0 addr=[0,1024)
  sum of sizes (no reuse) = 2560 bytes
  sharedMemorySize (with reuse) = 1536 bytes
  saved by reuse (A,C share offset 0) = 1024 bytes

=== call-graph two-level max ===
  bar.sharedMemorySize = 2048 B
  foo own buffers max  = 1536 B
  foo virtual buffer (=bar) = 2048 B, reuses offset 0
  foo.sharedMemorySize = max(1536,2048) = 2048 B
  module.getSharedMemorySize = max over roots = 2048 B
  smem/block=2048B -> blocks/SM by smem = 49152//2048 = 24
  smem/block=8192B -> blocks/SM by smem = 49152//8192 = 6
  smem/block=24576B -> blocks/SM by smem = 49152//24576 = 2
