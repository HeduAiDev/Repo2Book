{
  "triton_version": "3.2.0",
  "cases": [
    {
      "case": "A_direct_return_in_body",
      "contains_return": true,
      "dispatch": "CFG (visit_if_top_level)"
    },
    {
      "case": "B_assign_only",
      "contains_return": false,
      "dispatch": "scf.if (visit_if_scf)"
    },
    {
      "case": "C_transitive_bare_call",
      "contains_return": true,
      "dispatch": "CFG (transitively)"
    },
    {
      "case": "D_transitive_call_but_assigned",
      "contains_return": false,
      "dispatch": "scf.if (Assign 短路，未下探 RHS)"
    }
  ]
}