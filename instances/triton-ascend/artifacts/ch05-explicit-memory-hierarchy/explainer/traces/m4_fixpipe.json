{
  "mechanism": "M4",
  "cases": [
    {
      "case": "fp32 [64,128] NZ2ND (valid)",
      "src_handle": "l0c-handle",
      "dst_handle": "handle#2",
      "create_fixpipe": [
        [
          "create_fixpipe",
          "l0c-handle",
          "handle#2",
          "NZ2ND",
          "NO_DUAL",
          "NO_QUANT",
          "NO_RELU"
        ]
      ]
    },
    {
      "case": "fp16 [64,128] NZ2ND (valid)",
      "create_fixpipe": [
        [
          "create_fixpipe",
          "l0c-handle",
          "handle#2",
          "NZ2ND",
          "NO_DUAL",
          "NO_QUANT",
          "NO_RELU"
        ]
      ]
    },
    {
      "case": "src not tensor (buffer as src)",
      "outcome": "TypeError",
      "error": "src is not of tensor type"
    },
    {
      "case": "dst not buffer (tensor as dst)",
      "outcome": "TypeError",
      "error": "dst is not of buffer type"
    },
    {
      "case": "dst on L1 (not UB)",
      "outcome": "TypeError",
      "error": "dst must be located in the UB memory region"
    },
    {
      "case": "chip gate is_910_95=False",
      "outcome": "RuntimeError",
      "error": "this feature is only supported on Ascend910_95"
    }
  ]
}