{
 "params": {
  "pool_blocks_case1": 2,
  "pool_blocks_case2": 8,
  "hash_block_size": 16
 },
 "case_lazy_evict": {
  "steps": [
   {
    "step": 1,
    "action": "cache_full_blocks（满块入表）",
    "blk_has_hash": true,
    "map_size": 1,
    "blk_ref_cnt": 1
   },
   {
    "step": 2,
    "action": "free_blocks（ref_cnt 归零回队）",
    "blk_has_hash": true,
    "map_size": 1,
    "blk_ref_cnt": 0,
    "note": "哈希原样留在 map——『缓存』与『空闲』是同一队列的两端"
   },
   {
    "step": 3,
    "action": "get_new_blocks 复用该块（池紧）",
    "reused_is_same_block": true,
    "blk_has_hash": false,
    "map_size": 0,
    "blk_ref_cnt": 1,
    "note": "_maybe_evict_cached_block 这一刻才摘哈希——驱逐是惰性隐式的"
   }
  ]
 },
 "case_alias_cleanup": {
  "steps": [
   {
    "step": 1,
    "action": "主哈希 + 部分条目别名都指向块",
    "map_size": 2,
    "aliases_in_reverse_index": 1,
    "primary_is_main": true
   },
   {
    "step": 2,
    "action": "_remove_cached_block_hashes（驱逐/晋升/重指的第一步）",
    "num_removed": 2,
    "map_size": 0,
    "blk_has_hash": false,
    "reverse_index_empty": true,
    "note": "主哈希+别名一次摘干净——不留悬空键"
   }
  ]
 }
}