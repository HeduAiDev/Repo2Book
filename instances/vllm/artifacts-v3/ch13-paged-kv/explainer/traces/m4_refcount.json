{
 "driver": "run_m4_refcount.py",
 "mechanism": "m4 引用计数生命周期（block_pool.py:L647-L677 / L702-L742）",
 "pin": "vLLM v0.27.1 (6e448d0ea)",
 "impl": "ch13 implementation/ 只做减法精简版",
 "config": {
  "num_gpu_blocks": 6,
  "usable": 5,
  "block_size": 16
 },
 "life_of_one_block": [
  {
   "action": "r1 首次分配 get_new_blocks(1)",
   "block": 1,
   "ref_cnt": "0 -> 1",
   "ref_before": 0,
   "ref_after": 1,
   "free_blocks": 4,
   "returned_to_pool": "否（新主人登记）"
  },
  {
   "action": "r2 命中同前缀 touch([b])",
   "block": 1,
   "ref_cnt": "1 -> 2",
   "ref_before": 1,
   "ref_after": 2,
   "free_blocks": 4,
   "returned_to_pool": "否（ref_cnt≠0 无需出队——块本就不在自由队列）"
  },
  {
   "action": "r1 结束 free_blocks([b])",
   "block": 1,
   "ref_cnt": "2 -> 1",
   "ref_before": 2,
   "ref_after": 1,
   "free_blocks": 4,
   "returned_to_pool": "否（ref_cnt=1 未归零——r2 还在用，这正是共享的物理意义）"
  },
  {
   "action": "r2 结束 free_blocks([b])",
   "block": 1,
   "ref_cnt": "1 -> 0",
   "ref_before": 1,
   "ref_after": 0,
   "free_blocks": 5,
   "returned_to_pool": "是（归零且非 null → append_n 挂队尾；队尾段 [1]）"
  },
  {
   "action": "touch([b]) 救回驱逐候选",
   "block": 1,
   "ref_cnt": "0 -> 1",
   "ref_before": 0,
   "ref_after": 1,
   "free_blocks": 4,
   "returned_to_pool": "出队（ref_cnt==0 且非 null → free_block_queue.remove，空闲 5→4）"
  },
  {
   "action": "再 free_blocks([b])",
   "block": 1,
   "ref_cnt": "1 -> 0",
   "ref_before": 1,
   "ref_after": 0,
   "free_blocks": 5,
   "returned_to_pool": "是（归零回池）"
  },
  {
   "action": "free_blocks([null_block]) 占位块特判",
   "block": 0,
   "ref_cnt": "不维护 -> 不维护",
   "ref_before": "不维护",
   "ref_after": "不维护",
   "free_blocks": 5,
   "returned_to_pool": "否（is_null=True 分支挡住——空闲 5 不变；ref_cnt 本就不维护）"
  }
 ],
 "summary": {
  "max_ref_cnt_seen": 2,
  "owners_at_ref2": [
   "r1（首配）",
   "r2（touch 命中）"
  ],
  "free_rule": "ref_cnt−1 后 == 0 且非 null 才回自由队列（L730-L742）",
  "touch_rule": "+1；ref_cnt==0 且非 null 先 remove 出队（L710-L715）——ch15 前缀命中救回驱逐候选",
  "null_rule": "is_null 特判永不回队；ref_cnt 不维护（L187-L189 注释）"
 }
}