{
 "env": {
  "tokenizer": "gpt2",
  "vocab_size": 50257
 },
 "mutual_exclusion": [
  {
   "input": "{'json': '{}', 'regex': 'a'}",
   "error_head": "You can only use one kind of structured outputs constraint but multiple are specified: {'json': '{}'"
  },
  {
   "input": "{}",
   "error_head": "You must use one kind of structured outputs constraint but none are specified: {'json': None, 'regex"
  }
 ],
 "key_normalization": [
  {
   "case": "json(dict)",
   "enum": "JSON",
   "spec": "{\"a\": 1, \"b\": [2, 3]}"
  },
  {
   "case": "json(str,同 schema 异空格)",
   "enum": "JSON",
   "spec": "{\"b\": [2, 3], \"a\": 1}"
  },
  {
   "case": "json(str,dict 的 dumps 形)",
   "enum": "JSON",
   "spec": "{\"a\": 1, \"b\": [2, 3]}"
  },
  {
   "case": "json_object",
   "enum": "JSON_OBJECT",
   "spec": ""
  },
  {
   "case": "regex",
   "enum": "REGEX",
   "spec": "[0-9]+"
  },
  {
   "case": "choice",
   "enum": "CHOICE",
   "spec": "[\"yes\", \"no\"]"
  },
  {
   "case": "choice(字符串注入)",
   "enum": "CHOICE",
   "spec": "[\"yes\", \"no\"]"
  },
  {
   "case": "grammar",
   "enum": "GRAMMAR",
   "spec": "root ::= \"yes\""
  },
  {
   "case": "structural_tag",
   "enum": "STRUCTURAL_TAG",
   "spec": "{\"x\": 1}"
  }
 ],
 "per_request_key": {
  "r1_key": [
   "REGEX",
   "[0-9]+"
  ],
  "r1_key_equals_itself_cached": true,
  "r1_key_equals_r2_key": true,
  "cached_property_same_object_across_reads": true,
  "distinct_objects_across_requests": true
 },
 "choice_as_grammar": {
  "plain": "root ::= \"yes\" | \"no\" | \"maybe\"",
  "escaped": "root ::= \"a\\\"b\" | \"c\\\\d\""
 },
 "rewrite_in_place": {
  "before": {
   "choice": [
    "yes",
    "no"
   ],
   "grammar": null
  },
  "after": {
   "choice": null,
   "grammar": "root ::= \"yes\" | \"no\""
  },
  "grammar_value": "root ::= \"yes\" | \"no\"",
  "backend_chosen": "xgrammar",
  "backend_was_auto": true
 },
 "lark_detection": {
  "ebnf_has_assign": false,
  "lark_no_assign": true
 },
 "auto_ladder": [
  {
   "case": "choice [yes,no]",
   "backend": "xgrammar",
   "was_auto": true
  },
  {
   "case": "json multipleOf=5（xgrammar 预检不过）",
   "backend": "guidance",
   "was_auto": true
  },
  {
   "case": "json {a:integer}",
   "backend": "xgrammar",
   "was_auto": true
  }
 ],
 "backend_conflict": {
  "auto_reuse_passes": true,
  "auto_reuse_backend": "xgrammar",
  "explicit_conflict_error_head": "Request-level structured output backend selection is not supported. The request specified 'guidance', but vLLM"
 },
 "table_rows_m2": [
  [
   "json dict",
   "{\"a\": 1, \"b\": [2, 3]}",
   "JSON",
   "json.dumps 归一：{\"a\": 1, \"b\": [2, 3]}\", 键序保留"
  ],
  [
   "json str（dict 的 dumps 形）",
   "{\"a\": 1, \"b\": [2, 3]}",
   "JSON",
   "与 dict 形完全同串——同键"
  ],
  [
   "json str（异键序）",
   "{\"b\": [2, 3], \"a\": 1}",
   "JSON",
   "串不同→键不同（不做 canonical 化）"
  ],
  [
   "json_object",
   "（无串）",
   "JSON_OBJECT",
   "spec=空串 \"\""
  ],
  [
   "regex",
   "[0-9]+",
   "REGEX",
   "原样"
  ],
  [
   "choice",
   "[\"yes\", \"no\"]",
   "CHOICE",
   "list 也 json.dumps 归一"
  ],
  [
   "grammar",
   "root ::= \"yes\"",
   "GRAMMAR",
   "原样"
  ],
  [
   "structural_tag",
   "{\"x\": 1}",
   "STRUCTURAL_TAG",
   "原样（JSON 串）"
  ]
 ],
 "table_rows_m4": [
  [
   "改写前",
   "choice=['yes', 'no']",
   "grammar=None",
   "validate_xgrammar_grammar 入口"
  ],
  [
   "试编",
   "xgr.Grammar.from_ebnf(root ::= \"yes\" | \"no\")",
   "成功",
   "backend_xgrammar.py:L296-L301"
  ],
  [
   "改写后",
   "choice=None",
   "grammar=root ::= \"yes\" | \"no\"",
   "L302-L303 原地改写"
  ],
  [
   "引擎侧",
   "compile_grammar 五分派",
   "GRAMMAR 分支（无 CHOICE 分支）",
   "改写使引擎侧无需 CHOICE 分支"
  ]
 ]
}