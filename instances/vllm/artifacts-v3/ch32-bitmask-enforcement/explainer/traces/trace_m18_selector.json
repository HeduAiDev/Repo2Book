{
 "env": {
  "note": "真 use_v2_model_runner property（vllm/config/vllm.py:L577-L623 逐字承载）；env 用 os.environ 注入；HAS_TRITON 用模块属性覆盖（精简版 PEP 562 读取面）——与真实 env 语义一致"
 },
 "decision_table": [
  {
   "case": "env=1 强制 V2",
   "use_v2": true,
   "why": "env 显式设置优先，直接短路"
  },
  {
   "case": "env=0 强制 V1",
   "use_v2": false,
   "why": "env=0：即便稠密默认 V2 也被压回 V1"
  },
  {
   "case": "PCP=2",
   "use_v2": true,
   "why": "PCP 运行时只在 V2 实现（无 MLA 也 force V2）"
  },
  {
   "case": "spec=dspark",
   "use_v2": true,
   "why": "DSpark 只在 V2 GPU runner 实现 → 强制 V2"
  },
  {
   "case": "diffusion",
   "use_v2": true,
   "why": "diffusion 模型强制 V2"
  },
  {
   "case": "Llama 稠密生成（默认）",
   "use_v2": true,
   "why": "非 MoE 生成模型 → V2（v0.21『V2 opt-in』在 v0.27 反转为默认）——Llama 走 V2"
  },
  {
   "case": "Mixtral MoE（不在默认名单）",
   "use_v2": false,
   "why": "MoE 且架构不在默认 V2 名单 → V1"
  },
  {
   "case": "Qwen2Moe（在默认名单）",
   "use_v2": true,
   "why": "名单内 MoE → V2"
  },
  {
   "case": "pooling 模型",
   "use_v2": false,
   "why": "runner_type != generate → V1"
  },
  {
   "case": "attention-free",
   "use_v2": false,
   "why": "is_attention_free → V1"
  },
  {
   "case": "稠密但无 Triton",
   "use_v2": false,
   "why": "V2 requires Triton → 警告并回退 V1"
  },
  {
   "case": "spec=ngram（稠密）",
   "use_v2": false,
   "why": "ngram/ngram_gpu 未被 V2 支持 → 警告回退 V1"
  },
  {
   "case": "spec=eagle（稠密）",
   "use_v2": true,
   "why": "eagle 在 V2 支持名单 → V2"
  }
 ],
 "default_v2_architectures": [
  "DeepseekV2ForCausalLM",
  "GraniteMoeForCausalLM",
  "InklingForCausalLM",
  "InklingForConditionalGeneration",
  "KimiK3ForConditionalGeneration",
  "LongcatFlashNgramForCausalLM",
  "Qwen2MoeForCausalLM"
 ]
}