{
 "mechanisms": [
  "m8"
 ],
 "params": "租约默认 30s（kv_lease_duration）；D 等待队列里的请求按引擎分组发 HB: notif；重基准示例：scheduler_clock=99000、截止=100000",
 "constants": {
  "kv_lease_duration_s": 30,
  "heartbeat_interval_s": 5,
  "lease_extension_s": 20,
  "heartbeat_interval_formula": "kv_lease_duration // 6 = 30 // 6 = 5",
  "lease_extension_formula": "kv_lease_duration * 2 // 3 = 30 * 2 // 3 = 20",
  "heartbeats_per_lease": 6,
  "renewal_rate_x": 4.0
 },
 "rebase": {
  "scheduler_clock": 99000.0,
  "deadline_scheduler_domain": 100000.0,
  "remaining_ttl_s": 1000.0,
  "rebased_minus_t0_s": 1000.0,
  "in_range_990_1010": true,
  "note": "remaining = now_local + (deadline − scheduler_clock)；广播延迟只延长租约"
 },
 "legacy_no_clock": {
  "deadline_kept": 100000.0
 },
 "heartbeat_renewal": {
  "hb_message": "HB:req-1",
  "old_lease_remaining_s": 1.0,
  "new_expiry_formula": "time.perf_counter() + _lease_extension(20)",
  "deadline_movement_s": 19.0,
  "hb_arrived_and_extended": true,
  "second_hb_never_shortens": true,
  "second_delta_s": 0.01
 },
 "heartbeat_packaging": {
  "first_meta_has_hb": [
   "req-1"
  ],
  "immediate_second_meta_throttled": true,
  "throttle_interval_s": 5,
  "stops_after_finished_recving": true
 },
 "expiry_harvest": {
  "deadline_in_past_s": -1.0,
  "done_sending": [
   "req-dead"
  ],
  "req_left_to_send": true,
  "note": "get_finished 按到期序扫描，过期即强制 done_sending——D 失联时 P 显存自愈"
 }
}
