  "first_returns_future": true,
  "second_inflight_returns_future": true,
  "after_completion_returns_none": true,
  "remote_agent_registered": true
 },
 "hash_factors": {
  "factor_count": 10,
  "vllm_version": "0.27.1",
  "nixl_connector_version": 5,
  "hash_len": 64,
  "model_change_flips_hash": true,
  "backend_change_flips_hash": true,
