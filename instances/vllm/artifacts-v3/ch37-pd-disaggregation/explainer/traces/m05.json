  "matches_worker_hash": true,
  "agent_num_blocks": 8,
  "agent_block_lens": [
   512
  ],
  "agent_block_size": 4,
  "agent_kv_cache_layout": "HND",
  "agent_attn_backend": "FLASH_ATTN",
  "agent_physical_blocks_per_logical": 1,
  "two_phase_payload_fields": [
   "compatibility_hash",
   "agent_metadata_bytes"
  ]
 },
